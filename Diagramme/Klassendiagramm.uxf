<element><id>UMLClass</id><coordinates><x>300</x><y>460</y><w>320</w><h>270</h></coordinates><panel_attributes>*Automat*
&lt;&lt;logik.py&gt;&gt;
--
- db: Datenbank
+ zustand: Zustand
+ gewaehlt: Getraenk
+ zwischenspeicher: dict
--
+ Automat(db)
+ getraenke(): list[Getraenk]
+ waehlen(fach)
+ einwerfen(wert): Kaufergebnis
+ abbrechen(): Kaufergebnis
+ entnehmen()
+ eingeworfen(): int
+ restbetrag(): int</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLClass</id><coordinates><x>680</x><y>460</y><w>310</w><h>150</h></coordinates><panel_attributes>*logik.py*

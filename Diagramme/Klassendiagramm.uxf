--
+ TECHNIKER_PIN: str
--
+ berechne_rueckgeld(betrag, bestand): dict
+ format_euro(cent): str
+ parse_euro(text): int
+ pin_pruefen(eingabe): bool</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLNote</id><coordinates><x>1120</x><y>460</y><w>200</w><h>230</h></coordinates><panel_attributes>*Legende*
durchgezogener Pfeil:
kennt bzw. nutzt
gestrichelter Pfeil:
erzeugt bzw. ruft auf

Alle Beträge in Cent
(int). Umrechnung in
Euro nur für Anzeige
und CSV.</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLClass</id><coordinates><x>60</x><y>850</y><w>200</w><h>220</h></coordinates><panel_attributes>*Getraenk*
&lt;&lt;dataclass&gt;&gt;
--
+ id: int
+ fach: int
+ name: str
+ preis_cent: int
+ bestand: int
+ kapazitaet: int
+ bild: str
--
+ ausverkauft(): bool</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLClass</id><coordinates><x>300</x><y>850</y><w>360</w><h>370</h></coordinates><panel_attributes>*Datenbank*
&lt;&lt;datenbank.py&gt;&gt;
--
- verbindung: sqlite3.Connection
--
+ Datenbank(pfad)
+ geldsorten(): list
+ getraenke(): list[Getraenk]
+ wechselgeld(): dict
+ wechselgeld_tabelle(): list
+ einzahlung(): dict
+ verkaeufe(): list
+ statistik(von, bis): list
+ kauf_buchen(getraenk, eingeworfen, rueckgeld)
+ fach_auffuellen(fach)
+ alle_auffuellen()
+ wechselgeld_auffuellen()
+ einnahmen_leeren()
+ getraenke_importieren(liste)
+ wechselgeld_setzen(zeilen)
+ einzahlung_setzen(bestand)</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLClass</id><coordinates><x>720</x><y>850</y><w>300</w><h>180</h></coordinates><panel_attributes>*csv_io.py*
